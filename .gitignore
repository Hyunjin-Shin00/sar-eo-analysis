# 자격증명 — 절대 커밋하지 않는다
.env
.netrc
*credentials*
*secret*

# 데이터 (저장소에는 코드만 둔다)
*.tif
*.tiff
*.nc
*.h5
*.hdf
*.nitf
*.SAFE/
*.zip
*.gz
*.dim
*.data/
*.img
*.hdr
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.geojson
# data/ · outputs/ · results/ 는 이름만 보고 폴더를 통째로 뺐었다. 그 바람에
# eo/bluebon/downstream/aod/BlueBON/data/ 안의 코드가 조용히 빠졌다(2026-10-08 발견).
# 폴더가 아니라 **안의 자료 파일**을 빼고, 코드·문서는 어디 있든 담는다.
data/**
outputs/**
results/**
!**/data/
!**/outputs/
!**/results/
!**/data/**/
!**/outputs/**/
!**/results/**/
!**/data/**/*.py
!**/data/**/*.md
!**/data/**/*.sh
!**/data/**/*.csv
!**/data/**/*.json
!**/outputs/**/*.py
!**/outputs/**/*.md
!**/results/**/*.py
!**/results/**/*.md
!**/results/**/*.json
!**/results/**/*.geojson
!**/results/**/*.csv

# 산출 그림 — 단, figures/ 안의 참고용 webp 는 올린다
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.pdf
!**/figures/
!**/figures/*.webp

# 예외 — 인수심사 보고서 생성기의 참조표와 대표 결과
# 위 data/ · results/ · *.geojson · *.pdf 는 전역 규칙이라 아래를 명시적으로 되살린다.
# 참조표(기본풍속·ASOS)는 보고서의 기후 항목에 필요하고,
# 대표 결과 2건은 파이프라인이 무엇을 내는지 보여주는 유일한 산출 예시다.
!applications/underwriting/report-gen/data/
!applications/underwriting/report-gen/data/**
!applications/underwriting/report-gen/results/
!applications/underwriting/report-gen/results/**

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# OS / 편집기
.DS_Store
Thumbs.db
.vscode/
.idea/
