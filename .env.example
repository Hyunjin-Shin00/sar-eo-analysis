# 복사해서 .env 로 쓰고, 실제 값을 채운다. .env 는 커밋되지 않는다.
#   cp .env.example .env

# NASA Earthdata Login (ASF Sentinel-1 다운로드)
#   가입: https://urs.earthdata.nasa.gov/
EARTHDATA_USER=
EARTHDATA_PASS=

# Global Fishing Watch API (선박 데이터)
#   발급: https://globalfishingwatch.org/our-apis/
GFW_API_TOKEN=

# 기상청 API 허브
#   발급: https://apihub.kma.go.kr/
KMA_API_KEY=

# Copernicus Data Space Ecosystem (Sentinel-2)
CDSE_USER=
CDSE_PASS=

# USGS M2M API (Landsat 8/9)
USGS_USER=
USGS_TOKEN=

# BlueBON 처리 — 작업 목록 구글 시트
BLUEBON_SHEET_ID=

# BlueBON 지상 시험 — 버스 시뮬레이터 컨테이너
BUS_SIM_PASSWORD=

# 공공데이터포털 (건축물대장 표제부, 시추공 SPT)
#   발급: https://www.data.go.kr/
DATA_GO_KR_KEY=

# V-World (지오코딩 · 연속지적도 PNU)
#   발급: https://www.vworld.kr/
VWORLD_KEY=

# 카카오 로컬 (주소 지오코딩 보조)
#   발급: https://developers.kakao.com/
KAKAO_KEY=

# 국가지하수정보센터 (지하수 수위·관측소)
GIMS_KEY=
GIMS_KEY_DEPTH=
GIMS_KEY_STATION=

# 야적물 판독 VLM
#   발급: https://platform.openai.com/
OPENAI_API_KEY=

# BlueBON 미션 시트 — 구글 서비스계정 JSON 파일 경로
GSPREAD_CREDENTIALS=

# Earthdata 변수 이름이 두 벌이다. eo/bluebon/downstream/aod/ 아래 두 스크립트는
# 아래 이름을 읽는다. 위의 EARTHDATA_USER/PASS 와 같은 값을 넣을 것.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# SMOS 해빙두께 FTP 계정 이메일
SMOS_USER=

# SMOS 해빙두께 FTP 비밀번호
SMOS_PASS=
