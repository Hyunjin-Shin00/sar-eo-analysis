# 복사해서 .env 로 쓰고, 실제 값을 채운다. .env 는 커밋되지 않는다.
#   cp .env.example .env

# NASA Earthdata Login (ASF Sentinel-1 다운로드)
#   가입: https://urs.earthdata.nasa.gov/
EARTHDATA_USER=
EARTHDATA_PASS=

# Global Fishing Watch API (선박 데이터)
#   발급: https://globalfishingwatch.org/our-apis/
GFW_API_TOKEN=

# 기상청 API 허브
#   발급: https://apihub.kma.go.kr/
KMA_API_KEY=

# Copernicus Data Space Ecosystem (Sentinel-2)
CDSE_USER=
CDSE_PASS=

# USGS M2M API (Landsat 8/9)
USGS_USER=
USGS_TOKEN=

# BlueBON 처리 — 작업 목록 구글 시트
BLUEBON_SHEET_ID=

# BlueBON 지상 시험 — 버스 시뮬레이터 컨테이너
BUS_SIM_PASSWORD=
